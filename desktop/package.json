{
  "name": "homecoming-desktop",
  "productName": "Homecoming",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Brings your data home: gathers what every service keeps about you into one library on your Mac, to explore and ask questions of",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "fresh": "node build.mjs && node scripts/fresh.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:py && npm run test:e2e",
    "test:unit": "node --test 'test/unit/*.test.ts'",
    "test:py": "python3 -m unittest discover -s test/py -p 'test_*.py'",
    "test:e2e": "node build.mjs && node --test --test-concurrency=4 'test/e2e/*.test.ts'",
    "test:clis": "node --test 'test/clis/*.test.ts'",
    "test:real": "node build.mjs && UMP_REAL=1 node --test test/e2e/real_data.test.ts",
    "icons": "node scripts/build_icons.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "16.32.0",
    "typescript": "^7.0.2"
  }
}
